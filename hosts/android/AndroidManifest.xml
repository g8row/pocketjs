<?xml version="1.0" encoding="utf-8"?>
<!-- PocketJS Android host: a pure NativeActivity (no dex). It registers as both
     a launcher app and a HOME app so it can replace the stock launcher. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="dev.pocketjs.shell"
    android:versionCode="1"
    android:versionName="0.1.0">

    <uses-sdk android:minSdkVersion="24" android:targetSdkVersion="24" />
    <!-- deskd link: TCP to localhost (tunnelled over USB by adb reverse). -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:label="PocketJS"
        android:hasCode="false"
        android:allowBackup="false"
        android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen">

        <activity
            android:name="android.app.NativeActivity"
            android:label="PocketJS"
            android:screenOrientation="sensorLandscape"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:resizeableActivity="false"
            android:excludeFromRecents="true"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation|uiMode|density|fontScale|locale"
            android:exported="true">
            <meta-data android:name="android.app.lib_name" android:value="pocketjs" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
    </application>
</manifest>
